# GrantBridge Africa — environment variables (Step 3 prep; no secrets in this file)
# Copy to .env.local for local dev, or set the same keys in Vercel → Project → Settings → Environment Variables.
# NEVER commit a filled-in .env.local. Keys marked SECRET come via the Secure Vault form only, never in chat.

# ============ Supabase (project "GrantBridge Africa", Frankfurt) ============
# Project URL is public; the keys come from the dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://picdirzgyovjdonkwwsb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — server only, never NEXT_PUBLIC_*
SUPABASE_DB_PASSWORD=               # SECRET — only for the Supabase CLI link; not needed by the app
NEXT_PUBLIC_SITE_URL=               # set after deploy, e.g. https://grantbridge-africa-xxx.vercel.app

# ============ Stripe (existing Canadian account, TEST MODE first, USD only) ============
# Needed at Step 4. Test keys first; live keys only when the user says so.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=                  # SECRET
STRIPE_WEBHOOK_SECRET=              # SECRET — set after creating the webhook endpoint (Step 4)

# ============ Email: Resend free tier (3,000 emails/month) ============
# Needed at Step 8 (alerts) and for Service Order emails (Step 6).
RESEND_API_KEY=                     # SECRET

# ============ AI primary: Cloudflare Workers AI (free tier) ============
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
AI_API_KEY=                         # SECRET — Cloudflare API token
AI_EXTRACT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_WRITER_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_EMBED_MODEL=@cf/baai/bge-m3     # 1024-dim, multilingual (EN/FR/PT/AR)
# Separate embedding endpoint (the AI client supports it; same values as above unless split)
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=                   # SECRET
# Optional self-hosted / LiteLLM route (no code changes — env-driven only)
LITELLM_MASTER_KEY=                 # SECRET — only if a LiteLLM proxy is used
GOTENBERG_URL=                      # optional Word->PDF converter

# ============ AI fallback: Groq free tier (open-weight model) ============
AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK_API_KEY=                # SECRET
AI_FALLBACK_MODEL=openai/gpt-oss-120b

# ============ Meta Pixel + Conversions API (Step 5) ============
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=                    # SECRET
META_GRAPH_VERSION=                 # set to the current Graph API version — see developers.facebook.com/docs/graph-api/changelog
META_TEST_EVENT_CODE=

# ============ WhatsApp (optional; free click-to-chat first, Cloud API later) ============
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=                     # SECRET

# ============ Grant data APIs (free keys, Step 7 collector) ============
SIMPLER_GRANTS_API_KEY=             # SECRET
IATI_API_KEY=                       # SECRET

# ============ Admin ============
# The admin login email for the back office (provisional until the domain is bought).
ADMIN_EMAIL=admin@grantbridgeafrica.com
